# SQLite by default; switch to Postgres later, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/wealthwise
# DATABASE_URL defaults to SQLite at backend/wealthwise.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173

# Daily market-data refresh inside the API process (single worker only)
ENABLE_SCHEDULER=false
RISK_FREE_RATE=0.065
